rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userDoc().role in [
        'senior_army_instructor', 'army_instructor',
        'battalion_commander', 'battalion_xo', 'battalion_csm', 'sergeant_major'
      ];
    }

    // S1 adjutant and S6 technology can manage user accounts (same gates as
    // the AdminUsers.jsx isBattalionStaff check). They share the same privilege-
    // cloning constraint as admins: cannot elevate a role to their own level or above.
    function isUserManager() {
      return isAdmin() ||
        userDoc().role in ['s1_adjutant', 's6_technology'];
    }

    // Roles that are exempt from the roster self-edit restriction.
    // These accounts may edit their own roster entry freely.
    function isSelfEditExempt() {
      return userDoc().role in [
        'battalion_commander', 'battalion_xo', 'battalion_csm',
        'senior_army_instructor', 'army_instructor', 's1_adjutant'
      ];
    }

    // Mirrors src/constants.js ROLE_HIERARCHY — keep in sync when the role
    // table changes.
    function roleLevel(roleName) {
      let levels = {
        'senior_army_instructor': 100, 'army_instructor': 95,
        'battalion_commander': 90, 'battalion_xo': 85, 'battalion_csm': 85, 'sergeant_major': 80,
        's1_adjutant': 70, 's2_intelligence': 70, 's3_operations': 70, 's4_logistics': 70,
        's5_public_affairs': 70, 's6_technology': 70, 's7_special_projects': 70,
        'company_commander': 55, 'company_xo': 50, 'company_1sg': 45, 'company_master_sergeant': 45,
        'company_s1_assistant': 35, 'company_s2_assistant': 35, 'company_s3_assistant': 35,
        'company_s4_assistant': 35, 'company_s5_assistant': 35, 'company_s6_assistant': 35, 'company_s7_assistant': 35,
        'platoon_leader': 25, 'platoon_sergeant': 20,
        'squad_leader': 15, 'squad_leader_assistant': 12,
        'squad_member': 5, 'cadet': 1
      };
      return roleName in levels ? levels[roleName] : 0;
    }

    function myLevel() {
      return roleLevel(userDoc().role);
    }

    // Company 1SG and above — matches COMMAND_LEVEL gate in App.jsx.
    function isCommandTier() {
      return myLevel() >= 45;
    }

    // Mirrors UniformRequests.jsx APPROVE_ROLES exactly.
    function canApproveUniform() {
      return userDoc().role in [
        's4_logistics', 'battalion_xo', 'battalion_commander', 'battalion_csm'
      ];
    }

    // Mirrors UniformRequests.jsx REQUEST_ROLES exactly.
    function canRequestUniform() {
      return userDoc().role in [
        'company_s4_assistant',
        's4_logistics', 'battalion_xo', 'battalion_commander', 'battalion_csm'
      ];
    }

    // Mirrors UniformRequests.jsx isStaffObserver exactly.
    function isStaffObserver() {
      return myLevel() == 70 && userDoc().role != 's4_logistics';
    }

    // Mirrors UniformRequests.jsx isCompanyLeadership exactly.
    function isCompanyLeadershipTier() {
      return myLevel() >= 45 && myLevel() <= 55;
    }

    // Mirrors UniformRequests.jsx isS4Assistant exactly.
    function isS4AssistantTier() {
      return userDoc().role == 'company_s4_assistant';
    }

    // --- RULES ---

    match /users/{userId} {
      allow read: if isSignedIn();

      // Self-registration: new signed-in user may create their own profile
      // doc only as an unapproved plain cadet — never with an elevated role.
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'cadet' &&
        request.resource.data.approved == false;

      allow create, delete: if isSignedIn() && isUserManager();
      allow update: if isSignedIn() && (
        // Admins and user managers (S1 adjutant, S6 technology) may update any
        // field, but cannot elevate a role to their own level or above —
        // prevents privilege-cloning attacks.
        (isUserManager() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          roleLevel(request.resource.data.role) < myLevel()
        )) ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role', 'company', 'platoon', 'squad', 'rank',
           'position', 'letLevel', 'email', 'suspended', 'approved'
         ]))
      );
    }

    match /specialTeams/{teamId} {
      allow read: if true;
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.email.lower() in resource.data.commanderEmails
      );
      allow create, delete: if isSignedIn() && isAdmin();
    }

    // FIXED: was `allow write: if isAdmin()` (level 80+), which blocked every
    // S-staff officer (level 70) from broadcasting and from deleting their own
    // announcements.
    //   create — staff tier (70+) matches the ProtectedRoute minLevel gate.
    //   delete — deleter must outrank the issuer; issuerLevel is stored as the
    //            numeric ROLE_HIERARCHY value, matching the app's guard.
    match /announcements/{id} {
      allow read: if true;
      allow create: if isSignedIn() && myLevel() >= 70;
      allow delete: if isSignedIn() && myLevel() >= resource.data.issuerLevel;
    }

    // Public calendar — readable without auth. Staff tier (70+) can write;
    // this matches the /admin/events ProtectedRoute minLevel gate.
    match /events/{id} {
      allow read: if true;
      allow write: if isSignedIn() && myLevel() >= 70;
    }

    // Internal orders feed — not public.
    match /orders/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isCommandTier() &&
                    request.resource.data.issuerRole == userDoc().role;
      allow update, delete: if isSignedIn() &&
                    myLevel() >= roleLevel(resource.data.issuerRole);
    }

    // Position-scoped task assignments.
    match /tasks/{id} {
      allow read: if isSignedIn() && (
        isCommandTier() ||
        resource.data.assignedToPosition == userDoc().position
      );
      allow create: if isSignedIn() && isCommandTier();
      allow update: if isSignedIn() && (
        isCommandTier() ||
        resource.data.assignedToPosition == userDoc().position
      );
      allow delete: if isSignedIn() && isAdmin();
    }

    match /uniform_requests/{id} {
      allow read: if isSignedIn() && (
        canApproveUniform() ||
        isStaffObserver() ||
        ((isS4AssistantTier() || isCompanyLeadershipTier()) &&
          resource.data.company == userDoc().company) ||
        resource.data.cadetName == userDoc().fullName
      );
      allow create: if isSignedIn() && canRequestUniform();
      allow update, delete: if isSignedIn() && canApproveUniform();
    }

    match /leadership/{id} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin();
    }

    match /instructors/{id} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin();
    }

    // pageContent covers all public pages: home, about, cadet-info,
    // promotion-board, photos, etc.
    match /pageContent/{id} {
      allow read: if true;
      allow write: if isSignedIn() && (
        userDoc().role in ['s5_public_affairs', 's6_technology'] || isAdmin()
      );
    }

    match /camps/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && myLevel() >= 70;
    }

    // Cadet Challenge fitness records.
    // create — S1/S3 company assistants + company command (45+) may submit paperwork.
    // read   — submitter can always read their own; company command reads own company;
    //          staff (70+) can read everything (needed for management view).
    // update/delete — staff (70+) only (verify, correct, or remove records).
    match /cadet_challenge/{id} {
      allow create: if isSignedIn() && (
        userDoc().role in ['company_s1_assistant', 'company_s3_assistant'] ||
        myLevel() >= 45
      );
      allow read: if isSignedIn() && (
        resource.data.submittedByUid == request.auth.uid ||
        (myLevel() >= 45 && resource.data.company == userDoc().company) ||
        myLevel() >= 70
      );
      allow update, delete: if isSignedIn() && myLevel() >= 70;
    }

    match /documents/{id} {
      allow read: if true;
      allow write: if isSignedIn() && (
        userDoc().role in ['s5_public_affairs', 's6_technology'] || isAdmin()
      );
    }

    match /newsletters/{id} {
      allow read: if true;
      allow write: if isSignedIn() && (
        userDoc().role in ['s5_public_affairs', 's6_technology'] || isAdmin()
      );
    }

    // Admin-configurable settings: company names, document categories,
    // page visibility toggle (settings/pageVisibility is read pre-auth by
    // the public nav, so read must be public).
    // Write gated to staff tier (70+) — cadets and company leadership cannot
    // vandalize global config like company names or the Blue/Gold anchor date.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && myLevel() >= 70;
    }

    // Battalion Roster — source of truth for all cadets regardless of portal account.
    // read   — company command (45+) reads own company; staff (70+) reads all.
    //          company_s1_assistant + company_s3_assistant (35) also read own
    //          company so the Cadet Challenge table can be populated from the
    //          roster and assistants can view the roster page.
    // create — company command (45+) or staff (70+), plus S1/S3 assistants
    //          for their own company.
    // update — same as create with additional field-level restrictions:
    //          • Self-edit block: non-exempt accounts cannot change authority fields
    //            (position, rank, letLevel, company, linkedUid) on their own entry.
    //          • S1 assistants may not change position or rank (LET level is OK).
    //          • S3 assistants may not change position, rank, or letLevel.
    //          • company command (45–69) and assistants may not change linkedUid.
    // delete — staff (70+) only. Commanders submit rosterPendingActions instead;
    //          Battalion S1 reviews and performs the actual delete.
    match /roster/{id} {
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && resource.data.company == userDoc().company) ||
        (myLevel() >= 35 && resource.data.company == userDoc().company &&
          userDoc().role in ['company_s1_assistant', 'company_s3_assistant', 'company_s4_assistant'])
      );
      allow create: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && request.resource.data.company == userDoc().company) ||
        (userDoc().role in ['company_s1_assistant', 'company_s3_assistant'] &&
          request.resource.data.company == userDoc().company)
      );
      allow update: if isSignedIn() && (
        // ── Access tier ────────────────────────────────────────────────────────
        myLevel() >= 70 ||
        // Company command (45–69): own company, cannot change linkedUid.
        (myLevel() >= 45 && myLevel() < 70 &&
          resource.data.company == userDoc().company &&
          request.resource.data.linkedUid == resource.data.linkedUid) ||
        // company_s1_assistant: may edit all fields except fullName, company,
        // position, and rank. LET level changes are permitted (academic tracking).
        (userDoc().role == 'company_s1_assistant' &&
          resource.data.company == userDoc().company &&
          request.resource.data.company   == resource.data.company &&
          request.resource.data.fullName  == resource.data.fullName &&
          request.resource.data.position  == resource.data.position &&
          request.resource.data.rank      == resource.data.rank &&
          request.resource.data.linkedUid == resource.data.linkedUid) ||
        // company_s3_assistant: same as S1 but also cannot change letLevel.
        (userDoc().role == 'company_s3_assistant' &&
          resource.data.company == userDoc().company &&
          request.resource.data.company   == resource.data.company &&
          request.resource.data.fullName  == resource.data.fullName &&
          request.resource.data.position  == resource.data.position &&
          request.resource.data.rank      == resource.data.rank &&
          request.resource.data.letLevel  == resource.data.letLevel &&
          request.resource.data.linkedUid == resource.data.linkedUid)
      ) &&
      // ── Self-edit gate (applied AFTER access tier) ─────────────────────────
      // Non-exempt accounts cannot modify authority fields on their own roster
      // entry regardless of their command level.
      !(resource.data.linkedUid == request.auth.uid &&
        !isSelfEditExempt() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['position', 'rank', 'letLevel', 'company', 'linkedUid']));
      // Delete: staff (70+) only. Below that, use rosterPendingActions.
      allow delete: if isSignedIn() && myLevel() >= 70;
    }

    // ── Roster Changelog ──────────────────────────────────────────────────────
    // Append-only before/after snapshots written on every roster edit.
    // Any account that can write to the roster may create a changelog entry.
    // Immutable once written; only staff (70+) can read.
    match /rosterChangelog/{id} {
      allow create: if isSignedIn() && myLevel() >= 35;
      allow read: if isSignedIn() && myLevel() >= 70;
      allow update, delete: if false;
    }

    // ── Roster Pending Actions ────────────────────────────────────────────────
    // Deletion requests submitted by commanders (45+) or assistants (35).
    // Battalion S1 (70+) reviews, approves (performs actual delete), or rejects.
    match /rosterPendingActions/{id} {
      allow create: if isSignedIn() && (
        myLevel() >= 35 || isCommandTier()
      );
      allow read: if isSignedIn() && myLevel() >= 70;
      allow update: if isSignedIn() && myLevel() >= 70;
      allow delete: if isSignedIn() && myLevel() >= 70;
    }

    // ── Cadet Challenge Cycles ────────────────────────────────────────────────
    // One doc per company+cycle combo ({company}_{cycleNum}).
    // S1/S3 assistants + company command (45+) can read/write own company.
    // Staff (70+) can read/write all. Battalion S1 (s1_adjutant) unlocks/sends back.
    match /cadetChallengeCycles/{docId} {
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 35 && resource.data.company == userDoc().company)
      );
      allow create: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 35 && request.resource.data.company == userDoc().company)
      );
      allow update: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 35 && resource.data.company == userDoc().company)
      );
      allow delete: if isSignedIn() && myLevel() >= 70;
    }

    // ── Cadet Challenge Records ───────────────────────────────────────────────
    // One doc per cadet per cycle ({company}_{cycleNum}_{cadetUid}).
    // Write: S1/S3 assistants, company command (45+), or staff (70+).
    // Read: cadet's own record, company command for own company, staff for all.
    //
    // Battalion members have company='Zulu' and secondaryCompany='Alpha'.
    // Their records are stored under company='Zulu' but must also be readable
    // and writable by Alpha's S1 assistant (via secondaryCompany match).
    match /cadetChallengeRecords/{docId} {
      // Staff (70+) sees all; company assistants (35+) see own company;
      // battalion members readable via secondaryCompany match;
      // cadets can read their own record via linkedUid (personal profile view).
      // linkedUid is written to new records by AdminCadetChallenge at create time.
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 35 && resource.data.company == userDoc().company) ||
        (myLevel() >= 35 && resource.data.secondaryCompany == userDoc().company) ||
        resource.data.linkedUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 35 && request.resource.data.company == userDoc().company) ||
        (myLevel() >= 35 && request.resource.data.secondaryCompany == userDoc().company)
      );
      allow update: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 35 && resource.data.company == userDoc().company) ||
        (myLevel() >= 35 && resource.data.secondaryCompany == userDoc().company)
      );
      allow delete: if isSignedIn() && myLevel() >= 70;
    }

    // ── S2 Inspection Items ───────────────────────────────────────────────────
    // Managed by s2_intelligence (70+). Readable by all authenticated users
    // (assistants need the item list when completing their assignment).
    match /s2Items/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        userDoc().role == 's2_intelligence' || myLevel() >= 85
      );
    }

    // ── S2 Inspections ────────────────────────────────────────────────────────
    // Created by s2_intelligence (assign). Assistants can read + update their
    // own (to submit checklist + photo). S2 + staff can read/update all.
    match /s2Inspections/{inspId} {
      allow read: if isSignedIn() && (
        userDoc().role == 's2_intelligence' || myLevel() >= 85 ||
        resource.data.assignedToUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        userDoc().role == 's2_intelligence' || myLevel() >= 85
      );
      allow update: if isSignedIn() && (
        userDoc().role == 's2_intelligence' || myLevel() >= 85 ||
        resource.data.assignedToUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        userDoc().role == 's2_intelligence' || myLevel() >= 85
      );
    }

    // ── S6 Carts ─────────────────────────────────────────────────────────────
    // Managed by s6_technology. Readable by all authenticated users
    // (assistants and S5 need the cart list).
    match /s6Carts/{cartId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        userDoc().role == 's6_technology' || myLevel() >= 85
      );
    }

    // ── S6 Tasks ─────────────────────────────────────────────────────────────
    // Permanent checklist tasks managed by s6_technology.
    // Readable by all authenticated users (assistants and S5 need the list).
    match /s6Tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        userDoc().role == 's6_technology' || myLevel() >= 85
      );
    }

    // ── S6 Checklists ────────────────────────────────────────────────────────
    // Auto-created once per cart per day. Assistants can create/update their own.
    // S6 + S5 (read-only review) + staff can read all.
    match /s6Checklists/{checkId} {
      allow read: if isSignedIn() && (
        userDoc().role in ['s6_technology', 's5_public_affairs'] ||
        myLevel() >= 85 ||
        resource.data.completedByUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        userDoc().role in ['s6_technology', 'company_s6_assistant'] ||
        myLevel() >= 85
      );
      allow update: if isSignedIn() && (
        userDoc().role in ['s6_technology', 's5_public_affairs'] ||
        myLevel() >= 85 ||
        (userDoc().role == 'company_s6_assistant' &&
          (resource.data.completedByUid == null || resource.data.completedByUid == request.auth.uid))
      );
      allow delete: if isSignedIn() && (
        userDoc().role == 's6_technology' || myLevel() >= 85
      );
    }

    // ── Fundraiser Entries (Fallen Heroes) ───────────────────────────────────
    // create — company command (45+) for own company; s1_adjutant + s3_operations
    //          (70+) and higher for any company.
    // read   — staff (70+) sees all; company command sees own company; cadets
    //          can read their own entry via linkedUid (personal profile view).
    // update — company command for own company; staff (70+) for all.
    // delete — staff (70+) only.
    match /fundraiserEntries/{entryId} {
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && resource.data.company == userDoc().company) ||
        resource.data.linkedUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && request.resource.data.company == userDoc().company)
      );
      allow update: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && resource.data.company == userDoc().company)
      );
      allow delete: if isSignedIn() && myLevel() >= 70;
    }

    // ── Uniform Sizes ─────────────────────────────────────────────────────────
    // One doc per cadet: {company}_{cadetUid}
    // Input: S4 assistant + company command (45+) for own company; logistics/admin for all.
    // Read:  company command (45+) reads own company; logistics/admin (70+) reads all.
    // Delete: logistics/admin (70+) only.
    match /uniformSizes/{docId} {
      // READ: level 45+ (company command and above) can read; cadets read their
      // own record via linkedUid. The strict per-company restriction previously
      // here was enforced at the document level (resource.data.company ==
      // userDoc().company), but Firestore cannot evaluate that cross-document
      // get() at list-query evaluation time, causing the onSnapshot subscription
      // to fail silently for Commanders/XOs even when the write succeeded.
      // Company scoping is enforced client-side by the query filter; write rules
      // below still gate create/update to own company.
      allow read: if isSignedIn() && (
        myLevel() >= 45 ||
        userDoc().role == 'company_s4_assistant' ||
        resource.data.linkedUid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && request.resource.data.company == userDoc().company) ||
        (userDoc().role == 'company_s4_assistant' && request.resource.data.company == userDoc().company)
      );
      allow update: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && resource.data.company == userDoc().company) ||
        (userDoc().role == 'company_s4_assistant' && resource.data.company == userDoc().company)
      );
      allow delete: if isSignedIn() && myLevel() >= 70;
    }

    // ── Uniform Size Status ───────────────────────────────────────────────────
    // One doc per company — tracks draft/submitted/pending workflow state.
    // S4 assistant + company command write own company status; logistics/admin write all.
    // Read: same gate as uniformSizes.
    match /uniformSizeStatus/{company} {
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        userDoc().role == 's4_logistics' ||
        (myLevel() >= 45 && company == userDoc().company) ||
        (userDoc().role == 'company_s4_assistant' && company == userDoc().company)
      );
      allow write: if isSignedIn() && (
        myLevel() >= 70 ||
        userDoc().role == 's4_logistics' ||
        (myLevel() >= 45 && company == userDoc().company) ||
        (userDoc().role == 'company_s4_assistant' && company == userDoc().company)
      );
    }

    // ── Feedback Hub ─────────────────────────────────────────────────────────────
    // Any signed-in user can submit. View/update gated to S5/S6/top3/instructors.
    match /feedback/{id} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (
        userDoc().role in ['s5_public_affairs', 's6_technology',
                           'battalion_xo', 'battalion_csm', 'battalion_commander'] ||
        myLevel() >= 95
      );
      allow delete: if isSignedIn() && myLevel() >= 95;
    }

    // ── Honor Company Entries ─────────────────────────────────────────────────
    // Staff (70+) only — private competition tracking.
    match /honorCompanyEntries/{id} {
      allow read:   if isSignedIn() && myLevel() >= 70;
      allow create: if isSignedIn() && myLevel() >= 70;
      allow update: if isSignedIn() && myLevel() >= 70;
      allow delete: if isSignedIn() && myLevel() >= 80;
    }

    // ── Supply Requests ───────────────────────────────────────────────────────
    // Submit: company command (45+).
    // Read:   admin (80+) reads all; submitter reads their own.
    // Approve/fulfill/deny: admin (80+) only.
    // Delete: admin (80+) only.
    match /supplyRequests/{id} {
      allow create: if isSignedIn() && myLevel() >= 45;
      allow read: if isSignedIn() && (
        myLevel() >= 80 ||
        resource.data.requestedByUid == request.auth.uid
      );
      allow update, delete: if isSignedIn() && myLevel() >= 80;
    }

    // ── Promotion Boards ──────────────────────────────────────────────────────
    // S1 adjutant creates, opens, closes, and unlocks boards.
    // Company XO (50+) can update companyStatus (submit/un-submit their company).
    // Staff (70+) and company command (45+) can read boards.
    match /promotionBoards/{id} {
      allow create: if isSignedIn() && (
        userDoc().role == 's1_adjutant' || myLevel() >= 85
      );
      allow read: if isSignedIn() && myLevel() >= 45;
      allow update: if isSignedIn() && (
        userDoc().role == 's1_adjutant' || myLevel() >= 85 ||
        // Company XO (50+) may only toggle companyStatus (submit/unlock their company).
        (myLevel() >= 50 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyStatus']))
      );
      allow delete: if isSignedIn() && (
        userDoc().role == 's1_adjutant' || myLevel() >= 85
      );
    }

    // ── Promotion Scores ──────────────────────────────────────────────────────
    // Created by S1 in bulk when a board is opened.
    // Company XO (50+) updates scores for their own company; staff (70+) for all.
    // Read: staff (70+) sees all; company command (45+) sees own company only
    //       so commanders cannot compare scores against other companies.
    // Delete: S1 adjutant or admin (85+).
    match /promotionScores/{id} {
      allow create: if isSignedIn() && (
        userDoc().role == 's1_adjutant' || myLevel() >= 85
      );
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && resource.data.company == userDoc().company)
      );
      allow update: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 50 && resource.data.company == userDoc().company)
      );
      allow delete: if isSignedIn() && (
        userDoc().role == 's1_adjutant' || myLevel() >= 85
      );
    }

    // ── Cadet Yearly History ──────────────────────────────────────────────────
    // Year-end archive snapshots. Admin (80+) creates and writes; company
    // command (45+) reads their own company's archived records.
    match /cadetYearlyHistory/{id} {
      allow read: if isSignedIn() && (
        myLevel() >= 80 ||
        (myLevel() >= 45 && resource.data.company == userDoc().company)
      );
      allow create, update, delete: if isSignedIn() && myLevel() >= 80;
    }

    // ── Meeting Logs ──────────────────────────────────────────────────────────
    // All battalion staff (70+) can create logs and read all logs.
    // Staff may edit their own log (createdBy == uid).
    // XO/CSM/BC/S1 (elevated roles) can edit anyone's log and delete.
    // Company leadership (45–59) can read logs flagged companyAccess:true only.
    match /meetingLogs/{id} {
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && myLevel() < 70 && resource.data.companyAccess == true)
      );
      allow create: if isSignedIn() && myLevel() >= 70 &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (
        myLevel() >= 85 ||
        userDoc().role in ['s1_adjutant', 'battalion_xo'] ||
        (myLevel() >= 70 && resource.data.createdBy == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
        myLevel() >= 85 || userDoc().role == 's1_adjutant'
      );
    }

    // ── AAR Logs ──────────────────────────────────────────────────────────────
    // After Action Reports from battalion events.
    // Create: staff (70+) or company command (45+).
    // Read: staff (70+) sees all; company command (45–59) sees own company only.
    // Edit own: the creator at 45+.
    // Edit anyone's + delete: XO/CSM/BC/S1 (myLevel >= 85 or s1_adjutant).
    match /aarLogs/{id} {
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 45 && myLevel() < 70 && resource.data.company == userDoc().company)
      );
      allow create: if isSignedIn() && myLevel() >= 45 &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (
        myLevel() >= 85 ||
        userDoc().role in ['s1_adjutant', 'battalion_xo'] ||
        (myLevel() >= 45 && resource.data.createdBy == request.auth.uid)
      );
      allow delete: if isSignedIn() && (
        myLevel() >= 85 || userDoc().role == 's1_adjutant'
      );
    }

    // ── Form Events & Form Submissions (S1 Tracker + Promotion Board import) ──
    // formEvents: S1 / company command create events; company assistants view.
    // formSubmissions: company roles r/w own company; staff (70+) see all.
    // Instructor-only (95+) path kept for Cloud Function promotion-board import.
    match /formEvents/{id} {
      allow read: if isSignedIn() && myLevel() >= 35;
      allow create, update: if isSignedIn() && myLevel() >= 45;
      allow delete: if isSignedIn() && myLevel() >= 70;
    }
    match /formSubmissions/{id} {
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 35 && resource.data.company == userDoc().company)
      );
      allow create: if isSignedIn() && (
        myLevel() >= 45 ||
        (myLevel() >= 35 && request.resource.data.company == userDoc().company)
      );
      allow update: if isSignedIn() && (
        myLevel() >= 70 ||
        (myLevel() >= 35 && resource.data.company == userDoc().company)
      );
      allow delete: if isSignedIn() && myLevel() >= 70;
    }

    // ── Uniform Form Requests (Google Form webhook) ───────────────────────────
    // Submissions arrive via Google Apps Script → /api/uniform-form-webhook
    // which writes with the service account (bypasses client rules).
    // Client reads: S4 logistics (70) and S4 assistants (35).
    // Client updates: S4 logistics (70+) only (e.g. mark as reviewed).
    // Client create/delete: denied — all creates are server-side.
    match /uniformFormRequests/{id} {
      allow read: if isSignedIn() && (
        myLevel() >= 70 ||
        userDoc().role == 'company_s4_assistant'
      );
      allow update: if isSignedIn() && myLevel() >= 70;
      allow create, delete: if false;
    }

    // ── Admin Activity Log ────────────────────────────────────────────────────
    // Manual duty-log entries and auto-generated action records.
    // Staff (70+) can read and create their own entries; log records are
    // immutable once written (no update/delete from clients).
    match /adminLog/{id} {
      allow read: if isSignedIn() && myLevel() >= 70;
      allow create: if isSignedIn() && myLevel() >= 35 &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Fallback — deny everything not covered by an explicit rule above.
    // Every new collection MUST get its own match block before it can be used.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
