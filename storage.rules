rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // PDFs uploaded by admin/staff for newsletters, regulations, handbooks, etc.
    // Public read so cadets can open them without signing in.
    // Write requires authentication — the app-level route guard (STAFF_LEVEL)
    // is the primary gate; storage rules are the safety net.
    match /documents/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024   // 20 MB cap
                   && request.resource.contentType == 'application/pdf';
    }

    // S2 inspection photos — authenticated read (only portal users should see
    // inspection results); authenticated write restricted to images under 20 MB.
    match /s2-inspections/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // S6 end-of-class checklist photos — same auth policy as S2.
    match /s6-checklists/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Per-cadet yearly documents (after-school forms, permission slips, etc.).
    // Uploaded once per year per cadet; the app auto-converts PNG → JPEG before
    // upload so files stay small. PDFs accepted in case a family has a digital
    // copy. 5 MB cap is well above what a JPEG or WebP form scan should need.
    //
    // Path: cadet-documents/{uid}/{timestamp}_{filename}
    //   uid  — the cadet's Firebase Auth UID
    //
    // Read:   any signed-in portal member (staff review submissions).
    // Create/Update: any signed-in user — the UI controls who gets the button.
    // Delete: any signed-in user — admin-only enforcement happens at the app layer.
    match /cadet-documents/{uid}/{filename} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.size < 5 * 1024 * 1024
                            && (request.resource.contentType.matches('image/(jpeg|webp|png)')
                                || request.resource.contentType == 'application/pdf');
      allow delete:        if request.auth != null;
    }

  }
}
