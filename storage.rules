rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // PDFs uploaded by admin/staff for newsletters, regulations, handbooks, etc.
    // Public read so cadets can open them without signing in.
    // Write requires authentication — the app-level route guard (STAFF_LEVEL)
    // is the primary gate; storage rules are the safety net.
    match /documents/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024   // 20 MB cap
                   && request.resource.contentType == 'application/pdf';
    }

    // S2 inspection photos — authenticated read (only portal users should see
    // inspection results); authenticated write restricted to images under 20 MB.
    match /s2-inspections/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // S6 end-of-class checklist photos — same auth policy as S2.
    match /s6-checklists/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // S1 form-submission attachments — proof-of-turn-in photos/scans uploaded
    // by S1 assistants and company command when marking a submission turned in.
    // The app auto-converts PNG → JPEG before upload to keep file sizes small.
    //
    // Path: form-submissions/{eventId}/{submissionId}_{timestamp}_{filename}
    //
    // Read:   any signed-in portal member (commanders review their company).
    // Create/Update: any signed-in user with type/size gate; UI enforces who gets
    //                the upload button (CAN_MARK_ROLES in AdminS1.jsx).
    // Delete: any signed-in user — old file replaced automatically on re-upload.
    match /form-submissions/{allPaths=**} {
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.size < 5 * 1024 * 1024
                            && (request.resource.contentType.matches('image/(jpeg|webp|png)')
                                || request.resource.contentType == 'application/pdf');
      allow delete:         if request.auth != null;
    }

    // Per-cadet yearly documents keyed by Firebase Auth UID — reserved for
    // future direct-upload flows outside the S1 tracker.
    // Path: cadet-documents/{uid}/{timestamp}_{filename}
    match /cadet-documents/{uid}/{filename} {
      allow read:           if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.size < 5 * 1024 * 1024
                            && (request.resource.contentType.matches('image/(jpeg|webp|png)')
                                || request.resource.contentType == 'application/pdf');
      allow delete:         if request.auth != null;
    }

  }
}
